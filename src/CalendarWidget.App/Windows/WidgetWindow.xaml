<Window x:Class="CalendarWidget.App.Windows.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CalendarWidget.Presentation.ViewModels;assembly=CalendarWidget.Presentation"
        mc:Ignorable="d"
        Title="Desktop Calendar Widget"
        Width="288"
        SizeToContent="Height"
        MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Outer Rounded Shell -->
    <Border Background="{DynamicResource BackgroundRootBrush}"
            BorderBrush="{DynamicResource BorderDividerBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadiusWindow}"
            Padding="12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Header: [APP] and [─] -->
                <RowDefinition Height="Auto" />
                <!-- Subheader: Month Year & Clock -->
                <RowDefinition Height="Auto" />
                <!-- Weekday Column Headers -->
                <RowDefinition Height="Auto" />
                <!-- 42-cell Calendar Grid -->
                <RowDefinition Height="Auto" />
                <!-- Expandable Day Detail Tray -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header (Drag Handle) -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Switch to Full App Button -->
                <Button Grid.Column="0"
                        Command="{Binding SwitchToAppCommand}"
                        Content="[APP]"
                        Style="{DynamicResource HeaderActionButtonStyle}"
                        FontWeight="SemiBold"
                        ToolTip="Switch to full desktop application" />

                <!-- Drag region spacer -->
                <TextBlock Grid.Column="1"
                           Text="⋮⋮"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.4" />

                <!-- Minimize Button -->
                <Button Grid.Column="2"
                        Command="{Binding MinimizeCommand}"
                        Content="[─]"
                        Style="{DynamicResource HeaderActionButtonStyle}"
                        ToolTip="Minimize widget" />
            </Grid>

            <!-- 2. Subheader: Month/Year navigation and Digital Clock -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Month Year with subtle arrows -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousMonthCommand}"
                            Content="&lt;"
                            Style="{DynamicResource HeaderActionButtonStyle}"
                            Padding="4,1"
                            Margin="0,0,2,0" />
                    <TextBlock Text="{Binding MonthYearText}"
                               Style="{DynamicResource BodyRegularTextBlockStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="2,0" />
                    <Button Command="{Binding NextMonthCommand}"
                            Content="&gt;"
                            Style="{DynamicResource HeaderActionButtonStyle}"
                            Padding="4,1"
                            Margin="2,0,0,0" />
                </StackPanel>

                <!-- Digital Clock -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentTimeText}"
                           Style="{DynamicResource BodySubtleTextBlockStyle}"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 3. Weekday Column Headers -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding DayHeaders}"
                          Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontWeight="SemiBold" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 4. Compact 7x6 Calendar Grid -->
            <ItemsControl Grid.Row="3"
                          ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Margin="1"
                                Height="26"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="DayCellBorder"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource CornerRadiusDayCell}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <TextBlock x:Name="DayText"
                                                       Text="{Binding DayNumber}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeBodySubtle}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            
                                            <Ellipse x:Name="EventDot"
                                                     Width="3" Height="3"
                                                     Fill="{DynamicResource AccentDotBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Bottom"
                                                     Margin="0,0,0,2"
                                                     Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                            <Setter TargetName="DayCellBorder" Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="DayText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DayCellBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                            <Setter TargetName="EventDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 5. Expandable Day Detail Tray -->
            <Border Grid.Row="4"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusCard}"
                    Padding="10"
                    Margin="0,10,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedDayHeader}"
                                   Style="{DynamicResource BodySubtleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                        <Button Grid.Column="1"
                                Command="{Binding ToggleExpandedCommand}"
                                Content="✕"
                                Style="{DynamicResource HeaderActionButtonStyle}"
                                Padding="4,0"
                                FontSize="9"
                                ToolTip="Close details" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDividerBrush}" Margin="0,2,0,6" />

                    <TextBlock Text="No events scheduled"
                               Style="{DynamicResource BodySubtleTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,2" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
