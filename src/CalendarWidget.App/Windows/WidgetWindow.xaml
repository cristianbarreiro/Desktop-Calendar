<Window x:Class="CalendarWidget.App.Windows.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CalendarWidget.Presentation.ViewModels;assembly=CalendarWidget.Presentation"
        xmlns:conv="clr-namespace:CalendarWidget.Presentation.Converters;assembly=CalendarWidget.Presentation"
        mc:Ignorable="d"
        Title="Desktop Calendar Widget"
        Width="288"
        SizeToContent="Height"
        MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:IsSelectedDayConverter x:Key="IsSelectedDayConverter" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <!-- Outer Rounded Shell -->
    <Border Background="{DynamicResource BackgroundRootBrush}"
            BorderBrush="{DynamicResource BorderDividerBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadiusWindow}"
            Padding="12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Header: [APP] and [─] [✕] -->
                <RowDefinition Height="Auto" />
                <!-- Subheader: Month Year & Clock -->
                <RowDefinition Height="Auto" />
                <!-- Weekday Column Headers -->
                <RowDefinition Height="Auto" />
                <!-- 42-cell Calendar Grid -->
                <RowDefinition Height="Auto" />
                <!-- Expandable Day Detail Tray -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header (Drag Handle) -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Switch to Full App Button -->
                <Button Grid.Column="0"
                        Command="{Binding SwitchToAppCommand}"
                        Content="APP"
                        Style="{DynamicResource HeaderActionButtonStyle}"
                        FontWeight="SemiBold"
                        FontSize="10"
                        ToolTip="Switch to full desktop application"
                        AutomationProperties.Name="Switch to application"
                        Focusable="True" />

                <!-- Drag region spacer -->
                <Border Grid.Column="1"
                        Background="Transparent"
                        Cursor="SizeAll" />

                <!-- Window Controls: Minimize and Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding MinimizeCommand}"
                            Content="─"
                            Style="{DynamicResource HeaderActionButtonStyle}"
                            ToolTip="Minimize widget"
                            AutomationProperties.Name="Minimize"
                            Margin="0,0,2,0"
                            Focusable="True" />
                    <Button Click="OnCloseClick"
                            Content="✕"
                            Style="{DynamicResource HeaderActionButtonStyle}"
                            ToolTip="Close application"
                            AutomationProperties.Name="Close"
                            Focusable="True" />
                </StackPanel>
            </Grid>

            <!-- 2. Subheader: Month/Year navigation and Digital Clock -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Month Year with subtle arrows -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousMonthCommand}"
                            Content="‹"
                            Style="{DynamicResource HeaderActionButtonStyle}"
                            FontSize="16"
                            Padding="6,2"
                            Margin="0,0,4,0"
                            ToolTip="Previous month"
                            AutomationProperties.Name="Previous month"
                            Focusable="True" />
                    <TextBlock Text="{Binding MonthYearText}"
                               Style="{DynamicResource BodyRegularTextBlockStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="2,0" />
                    <Button Command="{Binding NextMonthCommand}"
                            Content="›"
                            Style="{DynamicResource HeaderActionButtonStyle}"
                            FontSize="16"
                            Padding="6,2"
                            Margin="4,0,0,0"
                            ToolTip="Next month"
                            AutomationProperties.Name="Next month"
                            Focusable="True" />
                </StackPanel>

                <!-- Digital Clock -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentTimeText}"
                           Style="{DynamicResource BodySubtleTextBlockStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="Medium"
                           FontFamily="Consolas, Segoe UI"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 3. Weekday Column Headers -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding DayHeaders}"
                          Margin="0,0,0,4"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppFontFamily}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 4. Compact 7x6 Calendar Grid -->
            <!-- 4. Compact 7x6 Calendar Grid -->
            <ItemsControl x:Name="CalendarGrid"
                          Grid.Row="3"
                          ItemsSource="{Binding Days}"
                          Focusable="True"
                          FocusVisualStyle="{x:Null}"
                          KeyboardNavigation.TabNavigation="Once"
                          KeyboardNavigation.DirectionalNavigation="None">
                <ItemsControl.InputBindings>
                    <KeyBinding Key="Left" Command="{Binding NavigateLeftCommand}" />
                    <KeyBinding Key="Right" Command="{Binding NavigateRightCommand}" />
                    <KeyBinding Key="Up" Command="{Binding NavigateUpCommand}" />
                    <KeyBinding Key="Down" Command="{Binding NavigateDownCommand}" />
                </ItemsControl.InputBindings>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Margin="1"
                                MinHeight="28"
                                MinWidth="28"
                                Cursor="Hand"
                                Focusable="True"
                                FocusVisualStyle="{x:Null}"
                                AutomationProperties.Name="{Binding Date, StringFormat='{}{0:MMMM d, yyyy}'}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="DayCellBorder"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="2"
                                            CornerRadius="{DynamicResource CornerRadiusDayCell}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <TextBlock x:Name="DayText"
                                                       Text="{Binding DayNumber}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeBodySubtle}"
                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <Ellipse x:Name="EventDot"
                                                     Width="4" Height="4"
                                                     Fill="{DynamicResource AccentDotBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Bottom"
                                                     Margin="0,0,0,2"
                                                     Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <!-- Outside current month: muted -->
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                            <Setter TargetName="DayCellBorder" Property="Opacity" Value="0.4" />
                                        </DataTrigger>

                                        <!-- Today indicator: accent tinted background + accent border + bold -->
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="DayCellBorder" Property="Background" Value="{DynamicResource TodayBackgroundBrush}" />
                                            <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="DayText" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>

                                        <!-- Hover: subtle background transition -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DayCellBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>

                                        <!-- Pressed: darker feedback -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="DayCellBorder" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                                        </Trigger>

                                        <!-- Keyboard focus indicator -->
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>

                                        <!-- Selected state: accent background with high-contrast text -->
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource IsSelectedDayConverter}">
                                                    <Binding Path="DataContext.SelectedDay"
                                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="DayCellBorder" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                                            <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBrush}" />
                                            <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter TargetName="DayText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>

                                        <!-- Today + Selected: both coexist with SurfaceSelected background and high-contrast Today border -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsToday}" Value="True" />
                                                <Condition Value="True">
                                                    <Condition.Binding>
                                                        <MultiBinding Converter="{StaticResource IsSelectedDayConverter}">
                                                            <Binding Path="DataContext.SelectedDay"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding />
                                                        </MultiBinding>
                                                    </Condition.Binding>
                                                </Condition>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="DayCellBorder" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                                            <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="{DynamicResource TodaySelectedBorderBrush}" />
                                            <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter TargetName="DayText" Property="FontWeight" Value="Bold" />
                                        </MultiDataTrigger>

                                        <!-- Has events dot -->
                                        <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                            <Setter TargetName="EventDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>

                                        <!-- Selected + HasEvents: high-contrast white dot on blue background -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasEvents}" Value="True" />
                                                <Condition Value="True">
                                                    <Condition.Binding>
                                                        <MultiBinding Converter="{StaticResource IsSelectedDayConverter}">
                                                            <Binding Path="DataContext.SelectedDay"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding />
                                                        </MultiBinding>
                                                    </Condition.Binding>
                                                </Condition>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="EventDot" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="EventDot" Property="Fill" Value="{DynamicResource SelectedEventDotBrush}" />
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 5. Expandable Day Detail Tray with animation -->
            <Border x:Name="DetailTray"
                    Grid.Row="4"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderDividerBrush}"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MaxHeight" Value="0" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                To="0,8,0,0"
                                                                Duration="0:0:0.18"
                                                                DecelerationRatio="0.7" />
                                            <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                                To="10"
                                                                Duration="0:0:0.18"
                                                                DecelerationRatio="0.7" />
                                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness"
                                                                To="0,1,0,0"
                                                                Duration="0:0:0.05" />
                                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                             To="140"
                                                             Duration="0:0:0.18"
                                                             DecelerationRatio="0.7" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.15"
                                                             DecelerationRatio="0.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                To="0"
                                                                Duration="0:0:0.15"
                                                                AccelerationRatio="0.5" />
                                            <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                                To="0"
                                                                Duration="0:0:0.15"
                                                                AccelerationRatio="0.5" />
                                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness"
                                                                To="0"
                                                                BeginTime="0:0:0.14"
                                                                Duration="0:0:0.01" />
                                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                             To="0"
                                                             Duration="0:0:0.15"
                                                             AccelerationRatio="0.5" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"
                                                             AccelerationRatio="0.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedDayHeader}"
                                   Style="{DynamicResource BodySubtleTextBlockStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   AutomationProperties.Name="Selected day" />
                        <Button Grid.Column="1"
                                Command="{Binding ToggleExpandedCommand}"
                                Content="✕"
                                Style="{DynamicResource HeaderActionButtonStyle}"
                                Padding="4,0"
                                FontSize="9"
                                ToolTip="Close details"
                                AutomationProperties.Name="Close details"
                                Focusable="True" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDividerBrush}" Margin="0,2,0,6" />

                    <TextBlock Text="No events scheduled"
                               Style="{DynamicResource BodySubtleTextBlockStyle}"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,2" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
