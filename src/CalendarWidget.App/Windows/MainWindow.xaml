<Window x:Class="CalendarWidget.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CalendarWidget.Presentation.ViewModels;assembly=CalendarWidget.Presentation"
        xmlns:views="clr-namespace:CalendarWidget.Presentation.Views;assembly=CalendarWidget.Presentation"
        mc:Ignorable="d"
        Title="Desktop Calendar"
        Height="620" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundRootBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="4"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainWindowRootGrid">
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="36" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource BorderDividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- App Title / Icon -->
                    <ColumnDefinition Width="*" />
                    <!-- Right Action / Caption Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Window Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="📅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Desktop Calendar"
                               Style="{DynamicResource BodyRegularTextBlockStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Caption Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Switch to Widget -->
                    <Button Command="{Binding SwitchToWidgetCommand}"
                            Content="⤢ Widget"
                            Style="{DynamicResource HeaderActionButtonStyle}"
                            ToolTip="Switch to compact desktop widget"
                            AutomationProperties.Name="Switch to widget"
                            AutomationProperties.AutomationId="SwitchToWidgetButton"
                            AutomationProperties.HelpText="Switch from full application to compact widget mode"
                            Margin="0,4,8,4" />

                    <!-- Window State Buttons -->
                    <Button x:Name="MinimizeButton"
                            Click="OnMinimizeClick"
                            Style="{DynamicResource WindowCaptionButtonStyle}"
                            ToolTip="Minimize"
                            AutomationProperties.Name="Minimize"
                            AutomationProperties.AutomationId="MinimizeButton">
                        <Path Data="M 2,7 H 12"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" />
                    </Button>
                    <Button Click="OnMaximizeRestoreClick"
                            x:Name="MaximizeRestoreButton"
                            Style="{DynamicResource WindowCaptionButtonStyle}"
                            ToolTip="Maximize"
                            AutomationProperties.Name="Maximize"
                            AutomationProperties.AutomationId="MaximizeButton">
                        <Path x:Name="MaximizeRestoreIcon"
                              Data="M 2,2 H 12 V 12 H 2 Z"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Click="OnCloseClick"
                            Style="{DynamicResource WindowCloseButtonStyle}"
                            ToolTip="Close"
                            AutomationProperties.Name="Close"
                            AutomationProperties.AutomationId="CloseButton">
                        <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Sidebar Navigation + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="180" />
                <!-- Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="0" Margin="8,16,8,8">
                        <Button Command="{Binding NavigateHomeCommand}"
                                Content="⌂  Home"
                                Style="{DynamicResource SidebarNavButtonStyle}"
                                ToolTip="Home"
                                AutomationProperties.Name="Home"
                                AutomationProperties.AutomationId="NavHomeButton"
                                AutomationProperties.HelpText="Navigate to Home view" />
                        <Button Command="{Binding NavigateCalendarCommand}"
                                Content="📅  Calendar"
                                Style="{DynamicResource SidebarNavButtonStyle}"
                                ToolTip="Calendar"
                                AutomationProperties.Name="Calendar"
                                AutomationProperties.AutomationId="NavCalendarButton"
                                AutomationProperties.HelpText="Navigate to Calendar view" />
                        <Button Command="{Binding NavigateNotesCommand}"
                                Content="📝  Notes"
                                Style="{DynamicResource SidebarNavButtonStyle}"
                                ToolTip="Notes"
                                AutomationProperties.Name="Notes"
                                AutomationProperties.AutomationId="NavNotesButton"
                                AutomationProperties.HelpText="Navigate to Notes view" />
                        <Button Command="{Binding NavigateSettingsCommand}"
                                Content="⚙️  Settings"
                                Style="{DynamicResource SidebarNavButtonStyle}"
                                ToolTip="Settings"
                                AutomationProperties.Name="Settings"
                                AutomationProperties.AutomationId="NavSettingsButton"
                                AutomationProperties.HelpText="Navigate to Settings view" />
                    </StackPanel>

                    <!-- Bottom Widget Switch Action -->
                    <StackPanel Grid.Row="1" Margin="8,8,8,16">
                        <Separator Background="{DynamicResource BorderDividerBrush}" Margin="4,0,4,8" />
                        <Button Command="{Binding SwitchToWidgetCommand}"
                                Content="⤢  Widget Mode"
                                Style="{DynamicResource SidebarNavButtonStyle}"
                                ToolTip="Switch to compact widget mode"
                                AutomationProperties.Name="Widget Mode"
                                AutomationProperties.AutomationId="NavWidgetButton"
                                AutomationProperties.HelpText="Switch to compact widget mode" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Content Area -->
            <ContentControl x:Name="MainContentControl"
                            Grid.Column="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding CurrentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                        <views:HomeView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
                        <views:CalendarView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:NotesViewModel}">
                        <views:NotesView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
