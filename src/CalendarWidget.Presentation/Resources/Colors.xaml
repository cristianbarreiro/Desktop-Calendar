<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Primitives -->
    <Color x:Key="ColorBackgroundRoot">#1E1E1E</Color>
    <Color x:Key="ColorSurfaceCard">#252526</Color>
    <Color x:Key="ColorSurfaceHover">#2D2D30</Color>
    <Color x:Key="ColorSurfaceSelected">#0078D4</Color>
    <Color x:Key="ColorSurfacePressed">#1A1A1C</Color>
    <Color x:Key="ColorTodayBackground">#1A3A5C</Color>
    <Color x:Key="ColorTodaySelectedBorder">#FFFFFF</Color>
    <Color x:Key="ColorSelectedEventDot">#FFFFFF</Color>
    <Color x:Key="ColorBorderDivider">#3E3E42</Color>
    <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextSecondary">#CCCCCC</Color>
    <Color x:Key="ColorTextDisabled">#858585</Color>
    <Color x:Key="ColorAccent">#0078D4</Color>

    <!-- SolidColorBrushes (Dark Theme / Default) -->
    <SolidColorBrush x:Key="BackgroundRootBrush" Color="{StaticResource ColorBackgroundRoot}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource ColorSurfaceCard}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource ColorSurfaceSelected}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource ColorSurfacePressed}" />
    <SolidColorBrush x:Key="TodayBackgroundBrush" Color="{StaticResource ColorTodayBackground}" />
    <SolidColorBrush x:Key="TodaySelectedBorderBrush" Color="{StaticResource ColorTodaySelectedBorder}" />
    <SolidColorBrush x:Key="SelectedEventDotBrush" Color="{StaticResource ColorSelectedEventDot}" />
    <SolidColorBrush x:Key="BorderDividerBrush" Color="{StaticResource ColorBorderDivider}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource ColorTextDisabled}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentDotBrush" Color="{StaticResource ColorAccent}" />

</ResourceDictionary>
