<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Font Families -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSizeHeaderLarge">26</sys:Double>
    <sys:Double x:Key="FontSizeHeaderMedium">18</sys:Double>
    <sys:Double x:Key="FontSizeBodyRegular">14</sys:Double>
    <sys:Double x:Key="FontSizeBodySubtle">12</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>

    <!-- Base TextBlock Style -->
    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="HeaderLargeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeaderLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HeaderMediumTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeaderMedium}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BodyRegularTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyRegular}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="BodySubtleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodySubtle}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

</ResourceDictionary>
