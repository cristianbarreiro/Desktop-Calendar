<UserControl x:Class="CalendarWidget.Presentation.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CalendarWidget.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CalendarViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area (Calendar Grid + Selected Day Panel) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Month & Year Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding MonthYearTitle}"
                           Style="{DynamicResource HeaderLargeTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Navigation Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding TodayCommand}"
                        Content="Today"
                        Style="{DynamicResource StandardButtonStyle}"
                        Margin="0,0,12,0" />
                <Button Command="{Binding PreviousMonthCommand}"
                        Content="&lt;"
                        Style="{DynamicResource StandardButtonStyle}"
                        Width="36"
                        Margin="0,0,4,0" />
                <Button Command="{Binding NextMonthCommand}"
                        Content="&gt;"
                        Style="{DynamicResource StandardButtonStyle}"
                        Width="36" />
            </StackPanel>
        </Grid>

        <!-- Main Body: Calendar Grid + Day Details -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- 7x6 Calendar Grid Section -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusCard}"
                    Padding="16"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Weekday Headers -->
                        <RowDefinition Height="Auto" />
                        <!-- 42-cell Grid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Day of Week Headers -->
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding DayHeaders}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{DynamicResource BodySubtleTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Padding="0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 42 Days Grid -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="2"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DayCellBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource CornerRadiusDayCell}"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <TextBlock x:Name="DayText"
                                                               Text="{Binding DayNumber}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Style="{DynamicResource BodyRegularTextBlockStyle}" />
                                                    
                                                    <!-- Optional Event Indicator Dot Placeholder -->
                                                    <Ellipse x:Name="EventDot"
                                                             Width="4" Height="4"
                                                             Fill="{DynamicResource AccentDotBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Bottom"
                                                             Margin="0,0,0,4"
                                                             Visibility="Collapsed" />
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <!-- Trailing / Leading month day styling (muted) -->
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                                    <Setter TargetName="DayCellBorder" Property="Opacity" Value="0.4" />
                                                </DataTrigger>

                                                <!-- Today Highlight -->
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="DayCellBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="DayText" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>

                                                <!-- Hover effect -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DayCellBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </Trigger>

                                                <!-- Has events dot -->
                                                <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                                    <Setter TargetName="EventDot" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Selected Day Summary Side Panel -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusCard}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="DAY DETAILS"
                               Style="{DynamicResource BodySubtleTextBlockStyle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    
                    <TextBlock Text="{Binding SelectedDateFormatted}"
                               Style="{DynamicResource HeaderMediumTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <Separator Background="{DynamicResource BorderDividerBrush}"
                               Margin="0,0,0,16" />

                    <!-- Events Empty State Shell -->
                    <Border Background="{DynamicResource BackgroundRootBrush}"
                            BorderBrush="{DynamicResource BorderDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusCard}"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No Events Scheduled"
                                       Style="{DynamicResource BodyRegularTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Event management and scheduling will be introduced in Phase 8."
                                       Style="{DynamicResource BodySubtleTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
