<UserControl x:Class="CalendarWidget.Presentation.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CalendarWidget.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NotesViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   Style="{DynamicResource HeaderLargeTextBlockStyle}"
                   Margin="0,0,0,24" />

        <!-- Empty State Container -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource BorderDividerBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusCard}"
                Padding="40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock Text="📝"
                           FontSize="40"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />
                <TextBlock Text="{Binding EmptyStateTitle}"
                           Style="{DynamicResource HeaderMediumTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding EmptyStateDescription}"
                           Style="{DynamicResource BodySubtleTextBlockStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24" />
                <Button Content="+ New Note"
                        Style="{DynamicResource StandardButtonStyle}"
                        HorizontalAlignment="Center"
                        IsEnabled="False"
                        ToolTip="Notes functionality will be implemented in Phase 9" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
